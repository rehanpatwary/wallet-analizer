# Copy to .env and fill in. NEVER commit .env.
# The wallet BIP39 mnemonic (12 words, space separated).
WALLET_MNEMONIC=

# Local mempool/esplora API (self-hosted node). Public fallbacks are used
# automatically when unreachable: mempool.space (BTC), litecoinspace.org (LTC).
MEMPOOL_API=http://10.10.20.3:3006/api

# Historical USD rates (daily klines). Override only if you need another venue.
BINANCE_API=https://api.binance.com
BTC_PAIR=BTCUSDT
LTC_PAIR=LTCUSDT

# Derivation sweep parameters
GAP_LIMIT=5000
ACCOUNT_DEPTH=10
